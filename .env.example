# Пример окружения. Скопируйте в .env и заполните — .env не коммитится (см. .gitignore).
# Единый .env в корне репозитория читают и transcribe.py, и utils/publish.

# --- Транскрипция (utils/transcribe.py) ---
# HF_TOKEN — токен Hugging Face, нужен для диаризации (загрузка гейтед-моделей pyannote).
# Получить токен: https://huggingface.co/settings/tokens
# Также нужно один раз принять условия моделей:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=

# --- Публикация (utils/publish) ---
# MEILI_URL — адрес инстанса Meilisearch; если не задан, шаг обновления поиска пропускается.
MEILI_URL=
# MEILI_KEY — админ-ключ Meilisearch (Bearer).
MEILI_KEY=
# HTTP_PROXY / HTTPS_PROXY — прокси для скрейпа лога чата (опционально).
HTTP_PROXY=
